{
	"name": "obsidian-study-time-statistics",
	"version": "1.2.0",
	"description": "Private, local-first study-time analytics for Obsidian notes and PDFs",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run lint && npm run lint:css && tsc -noEmit && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:css": "stylelint styles.css",
		"test": "tsx --test test/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tanzy226/obsidian-study-time-statistics.git"
	},
	"keywords": [
		"obsidian",
		"study",
		"analytics",
		"reading-time",
		"statistics"
	],
	"author": "tanzy226",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "22.15.17",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"esbuild": "^0.28.2",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.4.1",
		"globals": "17.6.0",
		"obsidian": "latest",
		"stylelint": "17.0.0",
		"stylelint-config-obsidianmd": "0.1.0",
		"tslib": "2.4.0",
		"tsx": "^4.20.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.66.0"
	},
	"dependencies": {
		"react": "18.3.1",
		"react-dom": "18.3.1"
	}
}
